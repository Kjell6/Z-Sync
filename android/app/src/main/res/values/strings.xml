    <string name="sync_zero_title">No spaces yet</string>
    <string name="sync_zero_body">Sign in on your desktop browser with the same Mozilla account, then turn on “Sync your sidebar across devices” under Settings → Sync. Your spaces and pinned tabs will appear here after the next sync.</string>
    <string name="sync_setup_hint_title">Pinned tabs aren\'t syncing yet</string>
    <string name="sync_setup_hint_body">Turn on sidebar sync on your desktop to get your pinned tabs and essentials here.</string>
    <string name="sync_setup_open">Show me how</string>
    <string name="sync_setup_title">Get your tabs syncing</string>
    <string name="sync_setup_intro">Z-Sync shows what your desktop browser syncs through its sidebar — your workspaces, pinned tabs, and essentials. Two things need to be set up first:</string>
    <string name="sync_setup_step1_title">Sign in with the same account</string>
    <string name="sync_setup_step1_body">Open your desktop browser on your computer and sign in with the same Mozilla account you used here.</string>
    <string name="sync_setup_step2_title">Turn on sidebar sync</string>
    <string name="sync_setup_step2_body">In your desktop browser open Settings → Sync and switch on “Sync your sidebar across devices”. It keeps your workspaces, pinned tabs, and folders in sync on all your devices.</string>
    <string name="sync_setup_step3_title">Come back and refresh</string>
    <string name="sync_setup_step3_body">Pull down on the main screen to refresh. Your spaces, pinned tabs, and essentials will appear as soon as they sync.</string>
    <string name="sync_setup_note">Mozilla account sync alone doesn\'t include pinned tabs and workspaces — the sidebar sync switch is what powers this app.</string>
    <string name="sync_setup_refresh">Refresh now</string>
    <string name="sync_tip_share_title">Pin from any app</string>
    <string name="sync_tip_share_body">Share a link from Safari or any app and pick a space — it lands in your pinned tabs.</string>
