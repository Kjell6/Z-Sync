{
  "$comment": "Design tokens copied verbatim from the iOS app (ios/Shared/ZenTheme.swift + spec). Android port mirrors these in Compose: ui/theme/Palette.kt, ui/theme/Type.kt, ui/motion/Motion.kt.",
  "color": {
    "coral": "#264540",
    "paper_light": "#F3ECE6",
    "paper_dark": "#1F1F1F",
    "ink_light": "#2E2E2E",
    "ink_dark": "#F3ECE6",
    "lift_light": "rgba(0,0,0,0.06)",
    "lift_dark": "rgba(255,255,255,0.07)"
  },
  "type": {
    "family": "Android system font (Roboto / device default)",
    "app_name": { "size": 32, "weight": "semibold", "rounded": true, "tracking": -0.5 },
    "space_title": { "size": 20, "weight": "bold", "rounded": true, "tracking": -0.3 },
    "tab_rows": { "size": 17, "weight": "medium", "rounded": false },
    "folder_names": { "size": 17, "weight": "bold", "rounded": false },
    "body": { "size": [15, 16], "rounded": true },
    "device_headers": { "size": 11, "weight": "semibold", "rounded": true, "uppercase": true, "tracking": 0.6 },
    "disclaimer": { "size": [11, 12], "rounded": true, "ink_opacity": [0.28, 0.4] }
  },
  "shape": {
    "primary_cta_radius": 16,
    "share_save_cta": "capsule",
    "account_bar_card": 18,
    "account_sheet_cards": [18, 20],
    "essential_tiles": 13,
    "favicon_clip_ratio": 0.22,
    "zen_mark_corner_ratio": 0.26,
    "zen_mark_ring_stroke": "max(2, size*0.07)",
    "zen_mark_padding_ratio": 0.24,
    "avatar_account_bar": 36,
    "avatar_account_sheet": 52
  },
  "motion": {
    "spring_mapping": "Compose spring(dampingRatio = d, stiffness = (2π/r)²)",
    "essentials_press": { "scale": 0.95, "opacity": 0.85, "response": 0.25, "damping": 0.75 },
    "space_switcher_select": { "response": 0.30, "damping": 0.85 },
    "switcher_extra": { "response": 0.25, "damping": 0.8 },
    "folder_expand_body": { "response": 0.35, "damping": 0.8 },
    "folder_icon_fold": { "response": 0.30, "damping": 0.8 },
    "gradient_crossfade": { "duration_ms": 280, "easing": "easeInOut", "slots": ["A", "B"] },
    "share_space_picker": { "response": 0.28, "damping": 0.8, "haptic": "CLOCK_TICK" },
    "share_saved_failed": { "response": 0.30, "damping": 0.8 },
    "share_saved_auto_dismiss_ms": 480,
    "cancellation_retry_delay_ms": 700,
    "folder_fold_transform": {
      "scale": "1 - 0.15*progress",
      "skew_degrees": "(isFront ? -16 : +16)*progress",
      "tx": "(isFront ? 8.0 : -5.2)*progress",
      "ty": "2.0*progress"
    },
    "reduced_motion": "Settings.Global.TRANSITION_ANIMATION_SCALE == 0 → snap without springs"
  },
  "haptics": {
    "share_save_success": "CONFIRM",
    "share_save_error": "REJECT",
    "space_menu_selection": "CLOCK_TICK / CONTEXT_CLICK"
  },
  "network": {
    "auth_base": "https://api.accounts.firefox.com/v1",
    "token_server": "https://token.services.mozilla.com/1.0/sync/1.5",
    "oauth_client_id": "5882386c6d801776",
    "oauth_grant": "fxa-credentials",
    "scope": "https://identity.mozilla.com/apps/oldsync",
    "webview_ua": "Mozilla/5.0 (Macintosh; Intel Mac OS X 10.15; rv:140.0) Gecko/20100101 Firefox/140.0"
  },
  "privacy": {
    "support_email": "Support@Kjell.cc",
    "policy_url": "https://github.com/Kjell6/Z-Sync/blob/main/docs/privacy.md"
  }
}
