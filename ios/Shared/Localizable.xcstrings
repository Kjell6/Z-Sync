    },
    "signin.help.how" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This login does not include sign-in through other services. If that is how you opened the Mozilla account, enter the email address of that service and the extra password you created for Firefox. That extra password is separate from the password of the other service. Only the Firefox one works here.\n\nIf you never created that extra Firefox password, because the other service was enough to sign in, you still need one on the Mozilla account. Open Firefox Accounts in a browser, set it there, then sign in here with that email and the extra password you just created."
          }
        }
      }
    },
